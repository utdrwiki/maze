{
	"name": "maze",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rm -rf out/ && node build.js && cp public/* out/",
		"deploy": "netlify deploy --dir=out --prod --no-build --skip-functions-cache --timeout=3600"
	},
	"devDependencies": {
		"netlify-cli": "27.13.0"
	},
	"allowScripts": {
		"esbuild": false,
		"netlify-cli": false,
		"sharp": false,
		"unix-dgram": false
	}
}
